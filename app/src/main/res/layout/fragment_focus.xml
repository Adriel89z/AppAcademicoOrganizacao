<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- topbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/topbar"
        android:gravity="bottom"
        android:paddingStart="20dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foco"
            android:textColor="@color/mcv_text_date_dark"
            android:textSize="28sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- conteudo geral -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- card -->
        <androidx.cardview.widget.CardView
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            card_view:cardCornerRadius="32dp"
            card_view:cardElevation="8dp"
            card_view:cardBackgroundColor="@color/background">

            <!-- conteudo do card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="30dp">

                <!-- titulo -->
                <TextView
                    android:id="@+id/textMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:text="Pomodoro"
                    android:textColor="@color/primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- base da ampulheta -->
                <FrameLayout
                    android:layout_width="320dp"
                    android:layout_height="320dp"
                    android:layout_marginTop="8dp">

                    <!-- glow -->
                    <ImageView
                        android:id="@+id/hourglass_glow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hourglass_glow" />

                    <!-- areia de baixo -->
                    <ImageView
                        android:id="@+id/bottomSand"
                        android:layout_width="220dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="72dp"
                        android:paddingLeft="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sand_bottom"
                        app:tint="@color/primary_dark" />

                    <!-- areia de cima -->
                    <ImageView
                        android:id="@+id/topSand"
                        android:layout_width="220dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="72dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/sand_top"
                        app:tint="@color/primary_dark" />

                    <!-- ampulheta -->
                    <ImageView
                        android:id="@+id/hourglassFrame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hourglass"
                        app:tint="@color/primary_dark" />

                    <!-- timer -->
                    <TextView
                        android:id="@+id/textTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="25:00"
                        android:textColor="@color/primary"
                        android:textSize="46sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- botões -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <!-- botão de play -->
                    <ImageButton
                        android:id="@+id/btnStartPause"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/background_button"
                        android:elevation="2dp"
                        android:padding="18dp"
                        android:src="@drawable/icon_play44"
                        app:tint="@color/white" />

                    <!-- botão de reset -->
                    <ImageButton
                        android:id="@+id/btnReset"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/background_button"
                        android:elevation="2dp"
                        android:padding="18dp"
                        android:src="@drawable/icon_timer44"
                        app:tint="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</LinearLayout>